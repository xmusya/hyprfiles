{
    "": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logogreen.png",
        "type": "kitty",
        "width": 30,
        "padding": { "top": 3, "right": 3 }
    },
    "display": {
        "separator": " ",
        "color": { "keys": "38;2;74;194;96", "title": "38;2;74;194;96" }
    },
    "modules": [
        { "type": "title", "format": " kowk@arch-btw" },
        { "type": "custom", "format": "\u001b[38;2;74;194;96m ┏━━━━━━━━━━━━━━━━━━━━━\u001b[0m" },
        { "type": "os", "key": " ┃ 󰣇 OS      :" },
        { "type": "kernel", "key": " ┃ 󰒋 KERNEL  :" },
        { "type": "uptime", "key": " ┃ 󰅐 UPTIME  :" },
        { "type": "packages", "key": " ┃ 󰏗 PKGS    :" },
        { "type": "shell", "key": " ┃  SHELL   :" },
        { "type": "terminal", "key": " ┃  TERM    :" },
        { "type": "de", "key": " ┃  DE/WM   :" },
        { "type": "bios", "key": " ┃ 󰓅 BIOS    :" },
        { "type": "display", "key": " ┃ 󰹑 SCREEN  :" },
        { "type": "cpu", "key": " ┃  CPU     :", "temp": true },
        { "type": "gpu", "key": " ┃ 󰢮 GPU     :", "temp": true },
        { "type": "memory", "key": " ┃  RAM     :" },
        { "type": "swap", "key": " ┃  SWAP    :", "format": "{1} / {2}" },
        { "type": "disk", "key": " ┃ 󰋊 DISK    :", "folders": "/" },
        { "type": "localip", "key": " ┃ 󰩟 IP      :", "ipv4": true },
        { "type": "datetime", "key": " ┃ 󰥔 TIME    :", "format": "{1}-{3}-{11} ; {14}:{17}:{20}" },
        { "type": "custom", "format": "\u001b[38;2;74;194;96m ┗━━━━━━━━━━━━━━━━━━━━━\u001b[0m" }
    ]
}
