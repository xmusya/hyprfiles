source=~/.config/hypr/hyprlock/colors.conf
monitor=,preferred,auto,auto

$terminal = kitty
$fileManager = dolphin
$menu = wofi --show drun
$browser = firefox
$mainMod = SUPER

# --- АВТОЗАПУСК ---
# 1. Критически важно для работы трея, порталов и обмена переменными
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
# 2. Убиваем захватчиков трея из KDE (фиксит ошибку StatusNotifierWatcher)
exec-once = pkill kded6 || pkill kded5

#exec-once = swww-daemon
exec-once = hyprpaper
exec-once = mako &
exec-once = hyprctl setcursor Bibata-Modern-Ice 20
exec-once = hypridle

# 4. Панель и апплеты (запускаем чуть позже, чтобы шина D-Bus успела проснуться)
exec-once = sleep 2 && waybar &
exec-once = nm-applet --indicator

# --- НАСТРОЙКИ ВВОДА ---
input {
    kb_layout = us,ru
    kb_options = grp:alt_shift_toggle
    follow_mouse = 1
    sensitivity = -1.0
    accel_profile = adaptive
    resolve_binds_by_sym = true
}

# --- ВИЗУАЛ ---
general {
    gaps_in = 2
    gaps_out = 2
    border_size = 2
    col.active_border = rgba(557a16ee)
    col.inactive_border = rgba(2b8a3eaa)
    layout = dwindle
}

decoration {
    rounding = 3    active_opacity = 1
    inactive_opacity = 1
    fullscreen_opacity = 1.0

blur {
    enabled = true
    size = 2         # Чем больше число, тем сильнее размытие
    passes = 2        # 3-4 прохода дадут отличный эффект и не убьют FPS
    new_optimizations = on
    xray = false      # Отключи xray, он часто портит вид на слабых картах

    noise = 0
    contrast = 1
    brightness = 1.2
}
    # УДАЛИ ОТСЮДА СТРОКИ blurls И layerrule, ИМ ТУТ НЕ МЕСТО!
}

animations {
    enabled = yes
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05
    animation = windows, 1, 7, myBezier
    animation = windowsOut, 1, 7, default, popin 80%
    animation = border, 1, 10, default
    animation = fade, 1, 7, default
    animation = workspaces, 1, 6, default
}

# --- БИНДЫ (ОСНОВНЫЕ) ---
bind = $mainMod, Q, exec, $terminal
bind = $mainMod, Return, exec, $terminal
bind = CONTROL ALT, T, exec, $terminal
bindr = $mainMod, SUPER_L, exec, pkill wofi || $menu
bind = $mainMod, W, exec, $browser
bind = $mainMod, E, exec, $fileManager
bind = $mainMod SHIFT, S, exec, grim -g "$(slurp)" - | wl-copy
bind = $mainMod, C, killactive,
bind = $mainMod, V, togglefloating,
bind = $mainMod, J, layoutmsg, togglesplit
bind = ALT, F4, killactive,

# --- КРИПТС (BINDS BY CODE) ---
bind = $mainMod, code:58, exec, ~/.config/kripts/powermenu.sh            # M
bind = $mainMod, code:46, exec, hyprlock                                 # L
bind = $mainMod SHIFT, code:27, exec, ~/.config/kripts/waybar_restart.sh # R
bind = CONTROL SHIFT, code:9, exec, plasma-systemmonitor                 # ESC
bind = $mainMod, code:40, exec, ~/.config/kripts/toggle_desktop.sh       # D

# --- ЗУМ ---
bind = $mainMod, equal, exec, ~/.config/kripts/zoom.sh inc
bind = $mainMod, minus, exec, ~/.config/kripts/zoom.sh dec
bind = $mainMod CONTROL, code:19, exec, ~/.config/kripts/zoom.sh reset
bind = $mainMod, code:19, exec, hyprctl keyword cursor:zoom_factor 1.0
bind = $mainMod, mouse_up, exec, ~/.config/kripts/zoom.sh inc
bind = $mainMod, mouse_down, exec, ~/.config/kripts/zoom.sh dec

# --- НАВИГАЦИЯ ---
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5

bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# --- ОКРУЖЕНИЕ ---
env = XCURSOR_THEME,Bibata-Modern-Ice
env = HYPRCURSOR_THEME,Bibata-Modern-Ice
env = XCURSOR_SIZE,21
env = HYPRCURSOR_SIZE,21
env = GDK_BACKEND,wayland,x11,*
env = QT_QPA_PLATFORM,wayland;xcb

# --- ПЕРЕМЕЩЕНИЕ ОКОН (SUPER + ALT + 1-5) ---
bind = $mainMod ALT, 1, movetoworkspacesilent, 1
bind = $mainMod ALT, 2, movetoworkspacesilent, 2
bind = $mainMod ALT, 3, movetoworkspacesilent, 3
bind = $mainMod ALT, 4, movetoworkspacesilent, 4
bind = $mainMod ALT, 5, movetoworkspacesilent, 5

# --- УПРАВЛЕНИЕ ЗВУКОМ ---
binde = , XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
binde = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bind = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bind = , XF86AudioPlay, exec, playerctl play-pause
bind = , XF86AudioNext, exec, playerctl next
bind = , XF86AudioPrev, exec, playerctl previous

# --- ПРИНУДИТЕЛЬНЫЙ ФУЛЛСКРИН (ALT + ENTER) ---
bind = ALT, Return, fullscreen, 0

# --- окна типо ---

layerrule = blur on, match:namespace waybar
layerrule = blur on, match:namespace kitty
layerrule = blur on, match:namespace wofi
