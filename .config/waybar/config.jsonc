 {
    "layer": "top",
    "position": "top",
    "height": 34,
    "modules-left": ["custom/apps", "custom/kitty", "hyprland/window"],
    "modules-center": ["hyprland/workspaces", "tray"],
    "modules-right": ["cpu", "memory", "memory#swap", "hyprland/language", "pulseaudio", "clock", "custom/desktop", "custom/power"],
    "hyprland/window": { "format": "{title}", "max-length": 25 },
    "hyprland/workspaces": { "persistent-workspaces": { "*": 5 } },
"tray": {
        "icon-size": 16,
        "spacing": 10,
        "show-passive-items": true
    },
    "cpu": { "format": " {usage}%" },
    "memory": {
        "format": " {used:0.1f}GiB/{total:0.1f}GiB",
        "interval": 5
    },
    "memory#swap": {
        "format": "󰓡 {swapUsed:0.1f}GiB/{swapTotal:0.1f}GiB",
        "interval": 5
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-ru": "RU",
        "on-click": "hyprctl switchxkblayout all next"
    },
    "clock": { "format": "{:%H:%M}" },
    "pulseaudio": { "format": "󰕾 {volume}%" },
    "custom/apps": {
        "format": "󰣇",
        "on-click": "pkill wofi || XCURSOR_THEME=Bibata-Modern-Classic wofi --show drun"
    },
    "custom/kitty": {
        "format": "󰄛",
        "on-click": "kitty",
        "tooltip": false
    },
    "custom/desktop": {
        "format": "󰖯",
        "on-click": "~/.config/kripts/toggle_desktop.sh",
        "tooltip": false
    }
}
