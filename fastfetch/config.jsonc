{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "",
    "color": {
      "1": "38;2;226;226;233",
      "2": "38;2;167;197;252",
      "3": "38;2;143;201;252",
      "4": "38;2;102;136;199"
    },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": " : ",
    "color": { "keys": "38;2;167;197;252", "title": "38;2;226;226;233" }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;226;226;233",
        "at": "37",
        "host": "38;2;167;197;252"
      }
    },
    { "type": "os",       "key": " ┏  OS      ", "keyColor": "38;2;226;226;233" },
    { "type": "board",    "key": " ┃ 󰐚 HOST    ", "keyColor": "38;2;219;222;241" },
    { "type": "kernel",   "key": " ┃ 󰒋 KERNEL  ", "keyColor": "38;2;212;218;248" },
    { "type": "uptime",   "key": " ┃ 󰅐 UPTIME  ", "keyColor": "38;2;205;214;250" },
    {
      "type": "command",
      "key": " ┃ 󰅐 OS AGE  ",
      "keyColor": "38;2;198;210;251",
      "text": "$HOME/.config/fastfetch/os-age.sh"
    },
    { "type": "packages", "key": " ┃ 󰏗 PKGS    ", "keyColor": "38;2;191;206;251" },
    { "type": "shell",    "key": " ┃  SHELL   ", "keyColor": "38;2;184;202;251" },
    { "type": "terminal", "key": " ┃  TERM    ", "keyColor": "38;2;177;198;251" },
    { "type": "de",       "key": " ┃  DE      ", "keyColor": "38;2;170;194;251" },
    { "type": "display",  "key": " ┃ 󰹑 SCREEN  ", "keyColor": "38;2;163;190;250" },
    { "type": "command",  "key": " ┃  CPU     ", "keyColor": "38;2;156;186;250", "text": "$HOME/.config/fastfetch/cpu.sh" },
    { "type": "gpu",      "key": " ┃ 󰢮 GPU     ", "keyColor": "38;2;149;182;250", "percent": { "type": 0 } },
    { "type": "memory",   "key": " ┃  RAM     ", "keyColor": "38;2;142;178;249" },
    { "type": "swap",     "key": " ┃  SWAP    ", "keyColor": "38;2;135;174;249" },
    { "type": "disk",     "key": " ┃ 󰋊 DISK    ", "keyColor": "38;2;128;170;249", "folders": "/" },
    { "type": "localip",  "key": " ┃ 󰩟 IP      ", "keyColor": "38;2;121;166;248" },
    { "type": "datetime", "key": " ┃ 󰥔 TIME    ", "keyColor": "38;2;114;162;248" },
    {
      "type": "custom",
      "key": " ┗  COLORS  ",
      "keyColor": "38;2;114;162;248",
      "format": "\u001b[38;2;226;226;233m● \u001b[38;2;167;197;252m● \u001b[38;2;143;201;252m● \u001b[38;2;0;228;121m● \u001b[38;2;252;179;138m● \u001b[38;2;255;179;180m● \u001b[38;2;235;178;255m●"
    }
  ]
}
