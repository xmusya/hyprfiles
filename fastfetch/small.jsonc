{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos_small",
    "color": {
      "1": "38;2;167;197;252",
      "2": "38;2;102;136;199"
    },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": " : ",
    "color": { "keys": "38;2;167;197;252", "title": "38;2;226;226;233" }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;226;226;233",
        "at": "37",
        "host": "38;2;167;197;252"
      }
    },
    { "type": "os",       "key": " ┏  OS      ", "keyColor": "38;2;226;226;233" },
    { "type": "packages", "key": " ┃ 󰏗 PKGS    ", "keyColor": "38;2;184;198;238" },
    { "type": "command",  "key": " ┃  CPU     ", "keyColor": "38;2;163;190;250", "text": "$HOME/.config/fastfetch/cpu.sh" },
    { "type": "gpu",      "key": " ┃ 󰢮 GPU     ", "keyColor": "38;2;143;174;240", "percent": { "type": 0 } },
    { "type": "terminal", "key": " ┃ 󰢮 TERM    ", "keyColor": "38;2;122;158;230" },
    { "type": "disk",     "key": " ┗ 󰋊 ROOT    ", "keyColor": "38;2;102;136;199", "folders": "/" }
  ]
}
